# CodeReviewAgent Configuration Example

# Groq API Key (required for LLM code review and fix generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Personal Access Token (PAT)
# Required for private repositories and publishing PR review comments.
# Required scopes for PR reviews: repo (for private repos) or public_repo (for public repos)
GITHUB_TOKEN=ghp_your_github_token_here
